  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "spec": {
      "additionalProperties": true,
