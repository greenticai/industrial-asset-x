package greentic:industrial-x-designer-extension;

// Minimal authoring extension: no host imports needed because the tools return
// static catalog hints and generated draft descriptors. We import shared base
// types for error/identity records and export the manifest, lifecycle, and
// design-tools interfaces the ext-runtime host expects.
world design-extension {
  import greentic:extension-base/types@0.1.0;

  export greentic:extension-base/manifest@0.1.0;
  export greentic:extension-base/lifecycle@0.1.0;
  export greentic:extension-design/tools@0.2.0;
}
