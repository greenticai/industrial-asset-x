{
  "scenario": "boundary",
  "description": "Oil/load ratio exactly on the upper band edge, then just beyond it: residual stays tiny, risk stays low, no rule fires.",
  "synthetic": true,
  "steps": [
    {
      "label": "on the edge",
      "request": {
        "readings": {
          "oil_temperature": 80.0,
          "winding_temperature": 70.0,
          "load": 100.0,
          "current": 10.0,
          "voltage": 220.0,
          "cooling_fan_status": "on",
          "cooling_pump_status": "on",
          "tap_position": 3
        },
        "features": {
          "temperature_rate_of_change": 0.1,
          "cooling_status_consistency": 1.0
        },
        "bindings": {
          "load_normalized_temperature": {
            "inputs": [
              "oil_temperature",
              "load"
            ]
          }
        },
        "scoring": {
          "feature": "load_normalized_temperature",
          "band": {
            "lower": 0.4,
            "upper": 0.8
          }
        }
      },
      "expect": {
        "status": 200,
        "baseline_risk": "low",
        "rules": {
          "inspect-cooling": "not_triggered"
        }
      }
    },
    {
      "label": "just beyond",
      "request": {
        "readings": {
          "oil_temperature": 80.1,
          "winding_temperature": 70.0,
          "load": 100.0,
          "current": 10.0,
          "voltage": 220.0,
          "cooling_fan_status": "on",
          "cooling_pump_status": "on",
          "tap_position": 3
        },
        "features": {
          "temperature_rate_of_change": 0.1,
          "cooling_status_consistency": 1.0
        },
        "bindings": {
          "load_normalized_temperature": {
            "inputs": [
              "oil_temperature",
              "load"
            ]
          }
        },
        "scoring": {
          "feature": "load_normalized_temperature",
          "band": {
            "lower": 0.4,
            "upper": 0.8
          }
        }
      },
      "expect": {
        "status": 200,
        "baseline_risk": "low",
        "rules": {
          "inspect-cooling": "not_triggered"
        }
      }
    }
  ]
}
