+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct ThermalBaseline {
+    pub no_load_rise_c: f64,
+    pub load_rise_c: f64,
+    pub cooling_relief_c: f64,
+    pub residual_band_c: f64,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct ThermalAssessment {
+    pub expected_temperature_c: f64,
+    pub thermal_residual_c: f64,
+    pub health: HealthAssessment,
+}
+
+impl ThermalBaseline {
+    #[must_use]
+    pub fn expected_temperature(
+        &self,
+        ambient_temperature_c: f64,
+        load_fraction: f64,
+        cooling_fraction: f64,
+    ) -> f64 {
+        let load = load_fraction.clamp(0.0, 1.0);
+        let cooling = cooling_fraction.clamp(0.0, 1.0);
+        ambient_temperature_c + self.no_load_rise_c + self.load_rise_c * load.powi(2)
+            - self.cooling_relief_c * cooling
+    }
+
+    #[must_use]
+    pub fn assess(
+        &self,
+        observed_temperature_c: f64,
+        ambient_temperature_c: f64,
+        load_fraction: f64,
+        cooling_fraction: f64,
+    ) -> ThermalAssessment {
+        let expected =
+            self.expected_temperature(ambient_temperature_c, load_fraction, cooling_fraction);
+        let band = ControlBand {
+            lower: expected - self.residual_band_c.abs(),
+            upper: expected + self.residual_band_c.abs(),
+        };
+        ThermalAssessment {
+            expected_temperature_c: expected,
+            thermal_residual_c: observed_temperature_c - expected,
+            health: assess_health(observed_temperature_c, band),
+        }
+    }
+}
+
